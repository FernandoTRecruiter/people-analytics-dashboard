    const prazo = ativosFim.filter(p => p.fimPrevisto && p.fimPrevisto > per.fim && p.fimPrevisto <= limite).length;
    if (prazo) alertas.push({ tipo: 'prazo', n: prazo, ir: 'quadro' });
