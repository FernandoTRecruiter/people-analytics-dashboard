  const mesCurto = (d, loc) => d.toLocaleDateString(loc, { month: 'short' }).replace('.', '') + ' ' + String(d.getFullYear()).slice(2);
  const mesISO = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
